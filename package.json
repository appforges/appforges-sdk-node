{
  "name": "@appforges/sdk",
  "version": "0.61.0",
  "description": "Official AppForges TypeScript SDK — generated by sdk-gen from the OpenAPI spec.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/appforges/sdk-gen" },
  "engines": { "node": ">=18" },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./*": {
      "import": { "types": "./dist/esm/*.d.ts", "default": "./dist/esm/*.js" },
      "require": { "types": "./dist/cjs/*.d.ts", "default": "./dist/cjs/*.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && printf '%s' '{\"type\":\"module\"}' > dist/esm/package.json && printf '%s' '{\"type\":\"commonjs\"}' > dist/cjs/package.json"
  },
  "publishConfig": { "access": "public" },
  "devDependencies": { "typescript": "5.9.3" }
}
